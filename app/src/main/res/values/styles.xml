<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textAppearance">@android:style/TextAppearance.Material.Title</item>
    </style>

    <style name="DomainEdit">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minLines">2</item>
        <item name="android:gravity">top|start</item>
        <item name="android:inputType">textMultiLine|textNoSuggestions|textUri</item>
        <item name="android:importantForAutofill">no</item>
    </style>
</resources>
