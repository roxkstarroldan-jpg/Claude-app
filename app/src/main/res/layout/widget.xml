<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the look of VPN app widgets like Surfshark's: one row high, flag + location,
     a small status icon on the right, and a slim full-width button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="7dp"
    android:paddingVertical="7dp">

    <LinearLayout
        android:id="@+id/widget_location_row"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_flag_image"
            android:layout_width="38dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_flag"
            android:layout_width="38dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="🌐"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widget_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="@string/widget_tap_location"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/widget_shield"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_widget_shield_off" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_button"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/widget_button_on"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/turn_on"
        android:textColor="#FF0B1D1E"
        android:textSize="15sp" />
</LinearLayout>
